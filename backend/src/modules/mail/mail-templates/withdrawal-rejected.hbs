<html>
  <head>
    <meta charset='UTF-8' />
    <title>Withdrawal Rejected</title>
  </head>
  <body
    style='font-family: Arial, sans-serif; background-color: #f9f9f9; padding: 20px;'
  >
    <div
      style='max-width: 600px; margin: auto; background-color: white; border-radius: 8px; padding: 30px; box-shadow: 0 0 10px rgba(0,0,0,0.1);'
    >
      <p style='background:#eeeeee'>
        <p
          style='padding:20px;color:#808080;text-align:center;font-size:40px;font-weight:600'
        >
          {{app_name}}
        </p>
      </p>
      <h2 style='color: #E53935;'>Withdrawal Rejected ❌</h2>
      <p>Dear {{freelancerName}},</p>
      <p>We regret to inform you that your withdrawal request of
        <strong>{{amount}} {{currency}}</strong>
        has been rejected.</p>
      <p><strong>Reason:</strong> {{rejectionReason}}</p>
      <p>Reference Code: <strong>{{referenceCode}}</strong></p>
      <p>Please review your withdrawal information and try again.</p>
      <hr />
      <p style='font-size: 12px; color: gray;'>If you need assistance, please
        reach out to our support team.</p>
    </div>
  </body>
</html>